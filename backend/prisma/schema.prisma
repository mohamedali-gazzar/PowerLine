// PowerLine data model.
// SQLite for local dev (zero-config). To move to PostgreSQL in production,
// change `provider` to "postgresql" and update DATABASE_URL — the models below
// are written to port cleanly. SQLite has no native enums, so enum-like fields
// are stored as String and validated in the API layer (Zod) instead.

generator client {
  provider      = "prisma-client-js"
  // native = local dev; rhel-openssl-3.0.x = Vercel serverless (Node 20 / AWS Lambda).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// The datasource block below is swapped automatically by scripts/db-setup.js
// (runs on `postinstall`):
//   local dev   -> sqlite (offline, prisma/dev.db)   <-- committed default
//   Vercel/prod -> postgresql (Neon)
// You normally never edit this block by hand.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A complete offer for a customer. Today it carries one RMU configuration
/// expressed in the Powerline coding system (PRAL/PSEC). LV panels and kiosks
/// will be added as sibling relations later.
model Offer {
  id          String @id @default(cuid())
  offerNumber String @unique
  // Product family: RMU | KIOSK | LV (only RMU is configurable today)
  category    String @default("RMU")
  projectName String
  customer    String
  // Lifecycle: DRAFT | SENT | WON | LOST
  status      String @default("DRAFT")

  // SLD / drawing cover fields
  salesNumber String?
  orderNumber String?

  // Offer cover-page fields (QTN / OPTY + sales contacts)
  quotationNo        String?
  opportunityNo      String?
  salesName          String?
  salesMobile        String?
  salesEmail         String?
  salesManagerName   String?
  salesManagerMobile String?
  salesManagerEmail  String?
  supportName        String?
  supportMobile      String?
  supportEmail       String?

  // Commercial (optional at this stage — technical offer is the focus)
  currency       String  @default("USD")
  usdToEgpRate   Float?
  unitPrice      Float   @default(0)
  quantity       Int     @default(1)
  discountPct    Float   @default(0)
  validityDays   Int     @default(30)
  deliveryWeeks  Int?
  paymentTerms   String?
  warrantyMonths Int?
  notes          String?
  // Offer date shown on the cover pages (user-set; falls back to createdAt).
  offerDate      String?

  rmu RmuConfig?

  // Accounts system: the signed-in user who created this offer, and when it was
  // "submitted" (RMU offers are generated on creation, so set on create).
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId     String?
  submittedAt DateTime?

  // ─ Price snapshot ──────────────────────────────────────────────────────────
  // The list prices this offer was quoted at, frozen when it was created. Without
  // these, re-reading an offer (or re-generating its PDF) re-prices it against
  // the CURRENT price list — silently rewriting quotations already sent to
  // customers whenever a price changes. All USD, pre-currency-conversion.
  // pricedAt == null means "created before snapshots existed" → live fallback.
  priceBookVersion Int?
  pricedAt         DateTime?
  /// true when the offer was priced while the price database was unreachable and
  /// the bundled fallback list was used — lets us find and re-price them later.
  pricedFromStale  Boolean   @default(false)
  snapPriceKey     String?
  snapBasePriceUsd Float?
  snapListPriceUsd Float?
  snapAddOnsJson   String? // JSON: [{ name, price }]
  snapVatPct       Float?
  snapPriceFound   Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// RMU configuration in the Powerline coding system, e.g. PRAL12(2+1+M).
/// The full technical content (general/electrical data + cubicle lineup) is
/// derived from this by the assembly engine — only the inputs are stored.
model RmuConfig {
  id      String @id @default(cuid())
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String @unique

  productType    String // PRAL (air) | PSEC (SF6/GIS)
  lbsBrand       String  @default("ABB") // ABB | MURGE | SCHNEIDER | JGGY | GRL
  clientSpec     String  @default("EECH") // EECH | KAHRABA (coding-system Variable 2)
  voltageKv      Int // 12 | 24
  nalCount       Int     @default(2) // LBS without fuse (NAL)
  nalfCount      Int     @default(1) // LBS with fuse (NALF)
  hasMetering    Boolean @default(false) // adds metering cubicle (M)
  rtuType        String  @default("NONE") // NONE | TYPE1 | TYPE2
  installation   String  @default("INDOOR") // INDOOR | OUTDOOR
  busbarCurrentA Int     @default(630)
  fuseRatingA    Int? // override; null → standard for the voltage

  // Metering options (used when hasMetering)
  meteringCtPrimaryA Int? // CT primary current (X in "X/5"); null → keep "X"
  ctClass            String? // CT accuracy class, default "0.5" (0.5 / 0.5S / 0.2)
  vtCores            Int  @default(1) // VT secondary cores: 1 or 2
  vtBurdenVa         String? // VT burden, default "50-100"
  vtClass            String? // VT accuracy class, default "0.5"
  meteringWithFuse   Boolean @default(false) // VT-Type: with fuse vs without

  // Cached human-readable code for quick listing/search, e.g. "PRAL12(2+1+M)".
  configCode String
}

// ─── Accounts system ─────────────────────────────────────────────────────────

/// A registered user of the configurator. Owns LV quotations and RMU offers, and
/// carries a profile photo (base64 data URL — serverless-safe, no disk on Vercel).
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("")
  passwordHash  String
  photo         String? // base64 data URL, e.g. "data:image/png;base64,..."
  emailVerified Boolean  @default(false)
  /// Access level: "USER" (default) | "PRICE_ADMIN" (may edit prices) | "OWNER"
  /// (may edit prices AND grant access). Read from the DB per request — never
  /// trusted from the JWT, so revoking access takes effect immediately.
  role          String   @default("USER")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lvQtns LvQtn[]
  offers Offer[]
}

/// One-time numeric codes emailed for sign-up verification and password reset.
/// Single-use + short expiry; the controller deletes them once consumed.
model EmailCode {
  id        String   @id @default(cuid())
  email     String
  code      String // 6-digit code
  purpose   String // "signup" | "reset"
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

/// A saved LV quotation owned by a user (migrated off browser localStorage). The
/// full LvState lives in `state` as a JSON string; the summary columns are sent
/// by the client on save so listing/stats need no business logic on the server.
model LvQtn {
  id          String    @id @default(cuid())
  number      String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  state       String // JSON-serialized LvState
  // client-computed summary (avoids duplicating pricing logic on the server)
  projectName String    @default("")
  customer    String    @default("")
  panelsCount Int       @default(0)
  totalEgp    Float     @default(0)
  submitted   Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attachments LvAttachment[]

  @@unique([ownerId, number])
  @@index([ownerId])
}

/// A file attached to a quotation (Specs tab) — client specifications, drawings,
/// e-mails. Deliberately NOT stored inside LvQtn.state: that JSON is re-saved on
/// every keystroke (debounced live-save), so a file in it would be re-uploaded
/// with each edit. Bytes are held as a base64 data string, the same
/// serverless-safe approach as User.photo (Vercel has no writable disk).
model LvAttachment {
  id     String @id @default(cuid())
  qtn    LvQtn  @relation(fields: [qtnId], references: [id], onDelete: Cascade)
  qtnId  String
  name   String // original filename as uploaded
  mime   String @default("application/octet-stream")
  size   Int    @default(0) // decoded byte length (what the UI shows)
  data   String // base64 (no data: prefix)
  /// Who uploaded it — kept as plain text so deleting a user never breaks the list.
  byEmail   String   @default("")
  createdAt DateTime @default(now())

  @@index([qtnId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRICE BOOK — the online price list
// ═══════════════════════════════════════════════════════════════════════════════
// Prices are edited as DRAFT rows (RmuPrice / LvComponent / LvEnclosure /
// PriceSetting). Nothing reaches a customer until "Update price list & database"
// PUBLISHES them: an immutable PriceSnapshot is written and PriceBook.version is
// bumped atomically. Readers compare the version they hold against PriceBook and
// refresh — so a publish is live on the very next request, with no redeploy.
//
// Every column here is String/Int/Float/Boolean/DateTime and every addition is
// nullable or defaulted, because `prisma db push --accept-data-loss` runs on
// every deploy: nothing may ever require a destructive migration.

/// Single row (id = "singleton"): which price book version is live.
model PriceBook {
  id          String   @id @default("singleton")
  /// 0 = never published; the bundled JSON is still authoritative.
  version     Int      @default(0)
  publishedAt DateTime @default(now())
  publishedBy String   @default("")
  note        String   @default("")
  /// "db" = serve the published snapshot | "json" = serve the bundled JSON.
  /// The emergency kill switch. Deliberately a DB field, not an env var, so
  /// recovering never requires a redeploy.
  source      String   @default("db")
  /// "EMPTY" | "SEEDING" | "READY" — drives the resumable first-time import.
  seedState   String   @default("EMPTY")
  seedCursor  Int      @default(0)
  seedStage   String   @default("")
}

/// An immutable published price list. ONE row read serves the whole catalogue,
/// so a cold serverless function never queries thousands of rows.
model PriceSnapshot {
  id        String   @id @default(cuid())
  domain    String // "RMU" | "LV"
  version   Int
  payload   String // JSON (same precedent as LvQtn.state)
  rowCount  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([domain, version])
  @@index([version])
}

/// One RMU price. `key` is DERIVED server-side from the attributes below using
/// the same builder the configurator uses — never typed by hand — so a row that
/// nothing can look up is structurally impossible.
model RmuPrice {
  id       String  @id @default(cuid())
  kind     String // "PANEL" | "LUCY" | "RTU" | "ADDON"
  key      String // "P-SEC24N2F1M1-With Fuse" | "2+1+M" | "PSEC:SMART1" | "outdoorEnclosure"
  priceUsd Float
  label    String  @default("") // ADDON: the text printed on the customer offer
  active   Boolean @default(true)

  // PANEL + LUCY attributes (LUCY reuses nalCount=feeders, nalfCount=transformers)
  family      String? // "P-RAL" | "P-SEC" | "P-SEC.M"
  voltageKv   Int? // 12 | 24
  nalCount    Int?
  nalfCount   Int?
  hasMetering Boolean @default(false)
  withFuse    Boolean @default(false)

  // RTU attributes
  productType String? // "PSEC" | "LUCY"
  rtuLevel    String? // "READY1" | "READY2" | "SMART1" | "SMART2"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String   @default("")

  @@unique([kind, key])
  @@index([kind, active])
}

/// Mirrors DbComponent in frontend/src/lv/catalog.ts field-for-field.
model LvComponent {
  id String @id @default(cuid())
  /// Catalogue ORDER, seeded from the current array index. Load-bearing: the
  /// combination builders resolve parts by description and take the FIRST match.
  sortIndex Int    @unique
  t         String @default("") // Type (MCB, MCCB, ACB…)
  f         String @default("") // Family
  r         String @default("") // Rating
  d         String // short description — combination lookup key
  n         String // display name    — combination lookup key
  ref       String @default("") // catalogue reference

  eur    Float   @default(0)
  egp    Float   @default(0)
  poles  Int     @default(0)
  cuP    Float   @default(0) // copper kg/pole — panels
  cuC    Float   @default(0) // copper kg/pole — cells
  brand  String  @default("ABB")
  stock  String  @default("")
  active Boolean @default(true)

  /// Lowercased "t f r d ref brand". Searching one lowercase column keeps local
  /// SQLite and production Postgres identical (Prisma case-insensitive mode is
  /// Postgres-only and would silently diverge between them).
  search String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String   @default("")

  @@index([active, sortIndex])
  @@index([t])
  @@index([ref])
}

/// Mirrors DbEnclosure. Also the price book for Pro-E / IS2 / PLP cells, which
/// are matched by a normalised form of `name` — so renaming one is significant.
model LvEnclosure {
  id        String  @id @default(cuid())
  sortIndex Int     @unique
  fam       String
  name      String // IDENTITY: cell matching parses this
  ref       String  @default("")
  abb       String  @default("")
  eur       Float   @default(0)
  egp       Float   @default(0)
  ip        String  @default("")
  H         Int     @default(0)
  W         Int     @default(0)
  D         Int     @default(0)
  mount     String  @default("")
  ral       String  @default("7035")
  active    Boolean @default(true)
  search    String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String   @default("")

  @@unique([fam, name])
  @@index([active, sortIndex])
  @@index([fam])
}

/// Scalars. scope "RMU": vatPct, currency.
/// scope "LV": factor, euro, usd, safetyFactor, copper, sheetMetal, operations,
///             abbDiscount, vat, forms.1 … forms.4b
model PriceSetting {
  id        String   @id @default(cuid())
  scope     String
  key       String
  num       Float?
  text      String?
  updatedAt DateTime @updatedAt
  updatedBy String   @default("")

  @@unique([scope, key])
}

/// Audit trail + undo. One row per changed field.
model PriceChange {
  id         String   @id @default(cuid())
  version    Int? // null = not yet published; stamped at publish
  domain     String // "RMU" | "LV"
  entity     String // "RmuPrice" | "LvComponent" | "LvEnclosure" | "PriceSetting"
  entityId   String
  label      String   @default("") // human-readable line, e.g. "Outdoor Enclosure"
  field      String // "priceUsd" | "eur" | "__created" | "__retired" | "__restored"
  oldValue   String?
  newValue   String?
  batchId    String? // groups one import / one publish / one undo
  actorId    String?
  actorEmail String   @default("")
  createdAt  DateTime @default(now())

  @@index([version])
  @@index([domain, createdAt])
  @@index([batchId])
  @@index([entity, entityId])
}

/// A staged bulk edit: preview first, apply second. Stored because the two steps
/// can land on different serverless instances.
model PriceImportBatch {
  id         String   @id @default(cuid())
  domain     String
  status     String   @default("PENDING") // PENDING | APPLIED | CANCELLED
  rows       String // JSON: parsed rows exactly as previewed
  diff       String // JSON: [{entity,label,field,from,to,kind}]
  warnings   String   @default("[]")
  actorId    String?
  actorEmail String   @default("")
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([status, expiresAt])
}

/// Regression guard for the LV combination builders (ATS / MCC / photocell),
/// which find their parts by DESCRIPTION. One row per distinct description, with
/// the part it resolves to today. Publishing is refused if any of them stops
/// resolving or starts resolving to a different part — which is how a new or
/// renamed component could otherwise silently re-price a saved combination.
model LvComboRef {
  id         String   @id @default(cuid())
  desc       String   @unique
  expectRef  String   @default("")
  expectName String   @default("")
  source     String   @default("combos.json")
  updatedAt  DateTime @updatedAt
}
